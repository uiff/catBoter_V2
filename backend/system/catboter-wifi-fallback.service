[Unit]
Description=CatBoter WiFi Fallback Access Point Service
After=network.target wpa_supplicant.service
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/iotueli/Desktop/catBoterV3
ExecStart=/usr/bin/python3 /home/iotueli/Desktop/catBoterV3/backend/system/wifi_fallback.py --data-dir /home/iotueli/Desktop/catBoterV3/backend/data
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=catboter-wifi-fallback

[Install]
WantedBy=multi-user.target
